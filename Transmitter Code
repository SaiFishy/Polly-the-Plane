#include <nRF24L01.h>
#include <RF24.h>
#include <Servo.h>

RF24 radio(7, 10); 
const byte address[6] = "00001";

Servo yawServo;   // Servo 1
Servo rollServo;  // Servo 2
Servo pitchServo; // Servo 3

const int motorPin = 3; // PWM Pin for Motor
unsigned long lastRecvTime = 0;

struct Data_Package {
  int throttle; // J1_X
  int yaw;      // J1_Y
  int j1_S; 
  int roll;     // J2_X
  int pitch;    // J2_Y
  int j2_S; 
};

Data_Package data;

void setup() {
  yawServo.attach(5);
  rollServo.attach(6);
  pitchServo.attach(9);
  pinMode(motorPin, OUTPUT);

  radio.begin();
  radio.openReadingPipe(0, address);
  radio.setPALevel(RF24_PA_LOW);
  radio.startListening();
}

void loop() {
  if (radio.available()) {
    radio.read(&data, sizeof(Data_Package));
    lastRecvTime = millis(); // Reset failsafe timer

    // 1. Motor Speed (Throttle) - J1 X
    int mSpeed = map(data.throttle, 0, 1023, 0, 255);
    analogWrite(motorPin, mSpeed);

    // 2. Yaw - J1 Y
    yawServo.write(map(data.yaw, 0, 1023, 0, 180));

    // 3. Roll - J2 X
    rollServo.write(map(data.roll, 0, 1023, 0, 180));

    // 4. Pitch - J2 Y
    pitchServo.write(map(data.pitch, 0, 1023, 0, 180));
  }

  // Failsafe: Stop motor if signal is lost for more than 1 second
  if (millis() - lastRecvTime > 1000) {
    analogWrite(motorPin, 0); 
    // Optional: Center servos on signal loss
    yawServo.write(90);
    rollServo.write(90);
    pitchServo.write(90);
  }
}
