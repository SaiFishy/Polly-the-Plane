-------------------------------- TRANSMITTER CODE ----------------------------


#include <nRF24L01.h>
#include <RF24.h>
#include <Servo.h>

RF24 radio(7, 10); 
const byte address[6] = "00001";

Servo yaw;   // Servo 1
Servo roll;  // Servo 2
Servo pitch; // Servo 3

const int motorPin = 3; // PWM Pin for Motor
unsigned long lastRecvTime = 0;

struct Data_Package {
  int throttle; // J1_X
  int yaw;      // J1_Y
  int j1_S; 
  int roll;     // J2_X
  int pitch;    // J2_Y
  int j2_S; 
};

Data_Package data;

void setup() {
  yaw.attach(5);
  roll.attach(6);
  pitch.attach(9);
  pinMode(motorPin, OUTPUT);

  radio.begin();
  radio.openReadingPipe(0, address);
  radio.setPALevel(RF24_PA_LOW);
  radio.startListening();
}

void loop() {
  if (radio.available()) {
    radio.read(&data, sizeof(Data_Package));
    lastRecvTime = millis(); // Reset failsafe timer

    // 1. Motor Speed (Throttle) - J1 X
    int mSpeed = map(data.throttle, 0, 1023, 0, 255);
    analogWrite(motorPin, mSpeed);

    // 2. Yaw - J1 Y
    yawServo.write(map(data.yaw, 0, 1023, 0, 180));

    // 3. Roll - J2 X
    rollServo.write(map(data.roll, 0, 1023, 0, 180));

    // 4. Pitch - J2 Y
    pitchServo.write(map(data.pitch, 0, 1023, 0, 180));
  }

  // Failsafe: Stop motor if signal is lost for more than 1 second
  if (millis() - lastRecvTime > 1000) {
    analogWrite(motorPin, 0); 
    // Optional: Center servos on signal loss
    yawServo.write(90);
    rollServo.write(90);
    pitchServo.write(90);
  }
}


---------------    RECIEVER CODE    -------------------------------------------

#include <SPI.h>
#include <nRF24L01.h>
#include <RF24.h>
#include <Servo.h>

// NRF24L01 Pins: CE=7, CSN=10, SCK=13, MOSI=11, MISO=12
RF24 radio(7, 10); 
const byte address[6] = "00001";

Servo esc;          // D9
Servo yawServo;     // D3
Servo leftElevon;   // D5
Servo rightElevon;  // D6

unsigned long lastRecvTime = 0;

struct Data_Package {
  int throttle; // J1_X
  int yaw;      // J1_Y
  int j1_S; 
  int roll;     // J2_X
  int pitch;    // J2_Y
  int j2_S; 
};

Data_Package data;

void setup() {
  esc.attach(9, 1000, 2000); // Standard ESC range (1ms to 2ms)
  yawServo.attach(3);
  leftElevon.attach(5);
  rightElevon.attach(6);

  radio.begin();
  radio.openReadingPipe(0, address);
  radio.setPALevel(RF24_PA_LOW);
  radio.startListening();
  
  yawServo.write(90);
  leftElevon.write(90);
  rightElevon.write(90);
  esc.writeMicroseconds(1000); // Ensure ESC is "off" at start
}

void loop() {
  if (radio.available()) {
    radio.read(&data, sizeof(Data_Package));
    lastRecvTime = millis();

    // 1. Throttle (ESC) - J1 X
    int throttleVal = map(data.throttle, 0, 1023, 1000, 2000);
    esc.writeMicroseconds(throttleVal);

    // 2. Yaw - J1 Y
    yawServo.write(map(data.yaw, 0, 1023, 0, 180));

    // 3. Elevon Mixing (Pitch & Roll) - J2
    int p = map(data.pitch, 0, 1023, -90, 90);
    int r = map(data.roll, 0, 1023, -90, 90);

    int leftVal = 90 + p + r;
    int rightVal = 90 + p - r;

    leftElevon.write(constrain(leftVal, 0, 180));
    rightElevon.write(constrain(rightVal, 0, 180));
  }

  // Failsafe
  if (millis() - lastRecvTime > 1000) {
    esc.writeMicroseconds(1000); // Stop motor
    yawServo.write(90);
    leftElevon.write(90);
    rightElevon.write(90);
  }
}
